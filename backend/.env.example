# KAIROS Environment Configuration

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# News Provider
NEWS_PROVIDER=coindesk
COINDESK_API_KEY=your_coindesk_api_key_here
# Optional endpoint override
# COINDESK_NEWS_URL=https://data-api.coindesk.com/news/v1/article/list

# Binance Testnet Mode (set to true for testing, false for production)
BINANCE_TESTNET=false

# Trading Configuration
CRYPTO_SYMBOL=BTCUSDT
KLINE_INTERVAL=4h

# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# DeepSeek / OpenAI-Compatible LLM (preferred)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

MAX_POSITION_SIZE_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
MIN_SIGNAL_CONFIDENCE=0.65

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# JWT / Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (optional — set for Google Sign-In)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin API key (optional — for programmatic admin access)
ADMIN_API_KEY=
